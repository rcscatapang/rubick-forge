{
  "compilerOptions": {
    "composite": true,
    // A referenced project may not disable emit (TS6310), so park the output
    // where it can't be mistaken for source: we only want the typecheck.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "package.json"]
}
